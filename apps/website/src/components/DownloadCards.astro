---
import platforms from '../data/platforms.json';
import PlatformGlyph from './PlatformGlyph.astro';

const MIN_OS: Record<string, string> = {
  mac: 'macOS 12.0 or later',
  windows: 'Windows 10 or later',
  android: 'Android 8.0 or later',
};
const SUBTITLE: Record<string, string> = {
  mac: 'Optimized for Mac',
  windows: 'For Windows 10/11',
  android: 'For Android 8.0+',
};
---
<section class="section download-cards" id="download">
  <div class="wrap">
    <h2 class="section-title" style="text-align:center">Download AllieMinate on Your Platform</h2>

    <div class="download-cards-grid" data-reveal-group>
      {platforms.map((p) => (
        <div class="card download-card reveal">
          <div class="download-card-head">
            <PlatformGlyph platform={p.device} size={36} />
            <div>
              <div class="download-card-name">{p.name}</div>
              <div class="download-card-sub">{SUBTITLE[p.device]}</div>
            </div>
          </div>
          <a class="btn btn-primary btn-block" href={p.downloadHref}>{p.downloadLabel}</a>
          <div class="download-card-req">{MIN_OS[p.device]}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .download-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }
  .download-card {
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .download-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .download-card-name {
    font-weight: 700;
    font-size: 16px;
  }
  .download-card-sub {
    font-size: 12.5px;
    color: var(--text-secondary);
  }
  .download-card-req {
    text-align: center;
    font-size: 12px;
    color: var(--text-tertiary);
  }

  @media (max-width: 767px) {
    .download-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
