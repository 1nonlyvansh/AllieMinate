---
import MacDevice from './devices/MacDevice.astro';
import WindowsDevice from './devices/WindowsDevice.astro';
import AndroidDevice from './devices/AndroidDevice.astro';
import PlatformGlyph from './PlatformGlyph.astro';
import CloudProviderStrip from './CloudProviderStrip.astro';
---
<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <span class="hero-eyebrow">Your Clouds. Your Devices. One Workspace.</span>
      <h1 class="hero-title">AllieMinate</h1>
      <p class="hero-headline">One workspace for every cloud you own, and every device you carry.</p>
      <p class="hero-sub">
        AllieMinate is a cross-platform file management and cloud integration application. Connect
        your favorite cloud storage accounts and access, manage, and transfer your files across
        your Mac, Windows PC, and Android devices — securely and seamlessly.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#download" data-primary-download>Download AllieMinate</a>
        <a class="btn btn-secondary" href="/product">Explore Features</a>
      </div>
      <div class="hero-available">
        <span class="hero-available-label">Available on</span>
        <span class="hero-available-item"><PlatformGlyph platform="mac" size={18} /> macOS</span>
        <span class="hero-available-item"><PlatformGlyph platform="windows" size={18} /> Windows</span>
        <span class="hero-available-item"><PlatformGlyph platform="android" size={18} /> Android</span>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <svg class="hero-arcs" viewBox="0 0 360 300" fill="none">
        <path class="connection-path" d="M180 150 C 140 110, 110 90, 90 65" stroke="var(--accent)" stroke-opacity="0.5" stroke-width="1.5" stroke-dasharray="4 5" stroke-linecap="round" />
        <path class="connection-path" d="M180 150 C 220 110, 250 90, 270 65" stroke="var(--accent)" stroke-opacity="0.5" stroke-width="1.5" stroke-dasharray="4 5" stroke-linecap="round" />
        <path class="connection-path" d="M180 150 C 180 200, 180 220, 180 250" stroke="var(--accent)" stroke-opacity="0.5" stroke-width="1.5" stroke-dasharray="4 5" stroke-linecap="round" />
      </svg>

      <div class="hero-node hero-node-mac">
        <div class="hero-node-device"><MacDevice size={90} /></div>
        <span>macOS</span>
      </div>
      <div class="hero-node hero-node-windows">
        <div class="hero-node-device"><WindowsDevice size={90} /></div>
        <span>Windows</span>
      </div>
      <div class="hero-node hero-node-android">
        <div class="hero-node-device"><AndroidDevice size={42} /></div>
        <span>Android</span>
      </div>

      <div class="hero-center">
        <div class="hero-center-ring"></div>
        <div class="hero-center-badge">
          <img src="/images/logo.svg" alt="" width="52" height="52" />
        </div>
        <p class="hero-center-caption">All Your Clouds.<br />All Your Devices.<br /><strong>One Workspace.</strong></p>
      </div>
    </div>
  </div>

  <div class="wrap hero-strip">
    <CloudProviderStrip />
  </div>
</section>

<style>
  .hero {
    padding: 148px 0 var(--space-6);
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-6);
    align-items: center;
  }
  .hero-eyebrow {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-text);
    font-size: 12.5px;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .hero-title {
    font-size: clamp(40px, 6vw, 68px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    background: linear-gradient(135deg, var(--text) 30%, var(--accent-text) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-headline {
    margin-top: var(--space-2);
    font-size: clamp(20px, 2.6vw, 28px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
    max-width: 540px;
  }
  .hero-sub {
    margin-top: var(--space-2);
    font-size: 15.5px;
    color: var(--text-secondary);
    max-width: 520px;
    line-height: 1.65;
  }
  .hero-cta {
    display: flex;
    gap: 12px;
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }
  .hero-available {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }
  .hero-available-label {
    font-size: 12.5px;
    color: var(--text-tertiary);
  }
  .hero-available-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--text-secondary);
    font-weight: 500;
  }
  .hero-strip {
    margin-top: var(--space-6);
  }

  .hero-visual {
    position: relative;
    height: 420px;
  }
  .hero-arcs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-node {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
  }
  .hero-node span {
    font-size: 12px;
    font-weight: 600;
    background: var(--glass-bg-strong);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .hero-node-mac {
    left: 2%;
    top: 4%;
  }
  .hero-node-windows {
    right: 2%;
    top: 4%;
  }
  .hero-node-android {
    left: 50%;
    bottom: 2%;
    transform: translateX(-50%);
  }
  .hero-center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero-center-ring {
    position: absolute;
    left: 50%;
    top: 44px;
    transform: translate(-50%, -50%);
    width: 190px;
    height: 190px;
    border-radius: 50%;
    border: 1.5px dashed var(--glass-border);
  }
  .hero-center-badge {
    position: relative;
    width: 88px;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-xl);
    background: var(--glass-bg-strong);
    border: 1px solid var(--glass-border);
    box-shadow: 0 0 60px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .hero-center-caption {
    margin-top: var(--space-2);
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .hero-center-caption strong {
    color: var(--accent-text);
  }

  @media (max-width: 1023px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      order: -1;
      max-width: 420px;
      margin: 0 auto;
      height: 360px;
    }
    .hero {
      padding-top: 120px;
      text-align: center;
    }
    .hero-cta,
    .hero-available {
      justify-content: center;
    }
    .hero-headline,
    .hero-sub {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-strip {
      display: flex;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .hero-visual {
      display: none;
    }
  }
</style>
