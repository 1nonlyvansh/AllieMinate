---
// Every link below resolves to something real — no Blog/FAQ/About Us/social handles, since none
// of those exist for this project (checked before writing this).
const COLUMNS = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '/product#features' },
      { label: 'Security', href: '/security' },
      { label: 'Roadmap', href: 'https://github.com/1nonlyvansh/AllieMinate#roadmap' },
      { label: 'Changelog', href: 'https://github.com/1nonlyvansh/AllieMinate/blob/main/CHANGELOG.md' },
    ],
  },
  {
    title: 'Platforms',
    links: [
      { label: 'macOS', href: '/platforms#mac' },
      { label: 'Windows', href: '/platforms#windows' },
      { label: 'Android', href: '/platforms#android' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Documentation', href: 'https://github.com/1nonlyvansh/AllieMinate/tree/main/docs' },
      { label: 'Support', href: 'https://github.com/1nonlyvansh/AllieMinate/issues/new?template=bug_report.md' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Service', href: '/terms' },
      { label: 'Contact Us', href: 'mailto:vansh080605@gmail.com' },
    ],
  },
];
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <img src="/images/logo.svg" alt="" width="24" height="24" />
        <span>AllieMinate</span>
      </a>
      <p>One workspace for every cloud you own, and every device you carry.</p>
      <a class="footer-social" href="https://github.com/1nonlyvansh/AllieMinate" target="_blank" rel="noopener" aria-label="AllieMinate on GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.75 5.48.75 11.75c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.17.69-3.84-1.34-3.84-1.34-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.33.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.63 0-1.24.44-2.26 1.17-3.06-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.58.23 2.75.11 3.04.73.8 1.17 1.82 1.17 3.06 0 4.37-2.67 5.34-5.21 5.62.41.36.77 1.06.77 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A11.26 11.26 0 0 0 23.25 11.75C23.25 5.48 18.27.5 12 .5Z" />
        </svg>
      </a>
    </div>

    {COLUMNS.map((col) => (
      <div class="footer-col">
        <div class="footer-col-title">{col.title}</div>
        {col.links.map((l) => (
          <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a>
        ))}
      </div>
    ))}
  </div>

  <div class="wrap footer-bottom">
    <p>© 2026 AllieMinate. All rights reserved.</p>
    <p>Made with <span class="footer-heart">♥</span> by Vansh Kishore Sharma</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--glass-border);
    padding: var(--space-6) 0 var(--space-4);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: var(--space-4);
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text);
    font-weight: 700;
    font-size: 15px;
  }
  .footer-brand p {
    margin-top: var(--space-2);
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 260px;
  }
  .footer-social {
    display: inline-flex;
    margin-top: var(--space-2);
    color: var(--text-secondary);
  }
  .footer-social:hover {
    color: var(--accent);
  }
  .footer-col-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-2);
  }
  .footer-col a {
    display: block;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 13px;
    margin-bottom: 10px;
  }
  .footer-col a:hover {
    color: var(--accent);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--glass-border);
    font-size: 12.5px;
    color: var(--text-tertiary);
  }
  .footer-heart {
    color: var(--offline);
  }

  @media (max-width: 1023px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
