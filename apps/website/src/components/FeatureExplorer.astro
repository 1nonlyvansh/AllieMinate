---
import features from '../data/features.json';
import Icon from './Icon.astro';
---
<section class="section" id="features">
  <div class="wrap">
    <div class="section-label">Feature Explorer</div>
    <h2 class="section-title">Everything, verified against the codebase.</h2>

    <div class="feature-grid" data-reveal-group>
      {features.map((f) => (
        <details class="card feature-card reveal">
          <summary class="feature-head">
            <Icon name={f.icon} size={22} />
            <span class="feature-title">{f.title}</span>
            <span class="feature-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="feature-body">
            <p>{f.desc}</p>
            <a href={f.anchor}>Learn more →</a>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    /* Without this, CSS Grid's default align-items:stretch makes every card in a row match
       the tallest one — so expanding a single card left its row siblings stretched into tall,
       empty-looking boxes. Each card sizes to its own content now. */
    align-items: start;
  }
  /* <details>/<summary> — a native disclosure widget instead of a hand-rolled JS toggle +
     CSS-grid height animation. The grid-based 0fr/1fr version had a real, hard-to-pin-down
     bug (the row's grid item was collapsing to zero height even with an explicit pixel row
     size forced inline with !important — something about this component's specific nesting
     broke the standard trick). Native <details> can't have that class of bug: the browser
     owns open/closed state, keyboard toggling, and screen-reader "expanded" announcements. */
  .feature-card {
    text-align: left;
    padding: var(--space-2) var(--space-3);
  }
  .feature-head {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    color: var(--accent);
    cursor: pointer;
    list-style: none;
  }
  .feature-head::-webkit-details-marker {
    display: none;
  }
  .feature-title {
    color: var(--text);
    font-weight: 600;
    font-size: 14.5px;
    flex: 1;
    text-align: left;
  }
  .feature-chevron {
    color: var(--text-secondary);
    transition: transform 0.2s var(--ease-out);
  }
  .feature-card[open] .feature-chevron {
    transform: rotate(180deg);
  }
  .feature-body {
    overflow: hidden;
  }
  .feature-body p {
    color: var(--text-secondary);
    font-size: 13.5px;
    line-height: 1.6;
    margin-top: 10px;
  }
  .feature-body a {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-size: 13px;
    margin-top: 6px;
  }

  @media (max-width: 1023px) {
    .feature-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
