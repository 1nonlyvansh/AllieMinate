---
import providers from '../data/providers.json';
---
<div class="provider-strip">
  {providers.map((p) => (
    <span class="provider-pill">
      <img src={p.logo} alt="" width="18" height="18" loading="lazy" />
      {p.name}
    </span>
  ))}
  <span class="provider-pill provider-pill-more">…and more</span>
</div>

<style>
  .provider-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .provider-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }
  .provider-pill img {
    border-radius: 4px;
  }
  .provider-pill-more {
    color: var(--text-tertiary);
    font-weight: 500;
  }
</style>
