---
interface Props {
  size?: number;
  class?: string;
}
const { size = 120, class: className = '' } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size * 0.62}
  viewBox="0 0 200 124"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Mac laptop"
>
  <rect x="34" y="6" width="132" height="86" rx="8" stroke="currentColor" stroke-width="3.4"/>
  <rect x="44" y="16" width="112" height="66" rx="2" fill="currentColor" fill-opacity="0.08"/>
  <path d="M6 106 L34 92 L166 92 L194 106 Z" stroke="currentColor" stroke-width="3.4" stroke-linejoin="round"/>
  <path d="M80 106 H120" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"/>
</svg>
