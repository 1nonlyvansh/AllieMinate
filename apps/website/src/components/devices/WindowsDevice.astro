---
interface Props {
  size?: number;
  class?: string;
}
const { size = 120, class: className = '' } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size * 0.62}
  viewBox="0 0 200 124"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Windows laptop"
>
  <rect x="30" y="8" width="140" height="82" rx="6" stroke="currentColor" stroke-width="3.4"/>
  <rect x="40" y="18" width="120" height="62" fill="currentColor" fill-opacity="0.08"/>
  <rect x="88" y="37" width="10" height="10" fill="currentColor"/>
  <rect x="102" y="37" width="10" height="10" fill="currentColor"/>
  <rect x="88" y="51" width="10" height="10" fill="currentColor"/>
  <rect x="102" y="51" width="10" height="10" fill="currentColor"/>
  <path d="M10 106 H190 L178 92 H22 Z" stroke="currentColor" stroke-width="3.4" stroke-linejoin="round"/>
</svg>
