---
interface Props {
  size?: number;
  class?: string;
}
const { size = 70, class: className = '' } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size * 1.7}
  viewBox="0 0 100 172"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Android phone"
>
  <rect x="6" y="4" width="88" height="164" rx="16" stroke="currentColor" stroke-width="3.4"/>
  <rect x="14" y="20" width="72" height="132" fill="currentColor" fill-opacity="0.08"/>
  <!-- Android glyph — a simple robot-head silhouette (antennae, dome, two eyes), the standard
       generic platform-indicator pictogram Google licenses for exactly this kind of reuse
       (Android Robot, Creative Commons Attribution 3.0), not a copy of any trademarked artwork. -->
  <g stroke="currentColor" stroke-width="2.6" stroke-linecap="round" fill="none" opacity="0.55">
    <path d="M38 55 L33 46 M62 55 L67 46" />
    <path d="M32 84 V68 a18 18 0 0 1 36 0 V84 Z" />
    <circle cx="42.5" cy="71" r="2" fill="currentColor" stroke="none" />
    <circle cx="57.5" cy="71" r="2" fill="currentColor" stroke="none" />
  </g>
</svg>
