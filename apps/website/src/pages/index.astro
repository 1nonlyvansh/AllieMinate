---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import GoogleAccessSection from '../components/GoogleAccessSection.astro';
import DownloadCards from '../components/DownloadCards.astro';
import GitHubSection from '../components/GitHubSection.astro';
import Footer from '../components/Footer.astro';

const WHAT_IT_DOES = [
  { icon: 'cloud', title: 'Connect Your Clouds', desc: 'Add and manage multiple cloud storage accounts in one secure workspace.' },
  { icon: 'devices', title: 'Access Across Devices', desc: 'Use AllieMinate on macOS, Windows, and Android to access your files anytime, anywhere.' },
  { icon: 'folder-tree', title: 'Manage Your Files', desc: 'Browse, upload, download, rename, and organize files across all your connected clouds.' },
  { icon: 'sync', title: 'Transfer with Ease', desc: 'Move files between clouds and devices quickly without third-party servers in between.' },
  { icon: 'shield', title: 'Your Data, Your Control', desc: 'Your data stays with your cloud providers. We don’t store your files on our servers.', tone: 'green' },
];
---
<Base>
  <Nav />
  <main id="main">
    <Hero />
    <FeatureGrid eyebrow="Features" title="What AllieMinate Does" items={WHAT_IT_DOES} columns={5} />
    <GoogleAccessSection />
    <DownloadCards />
    <GitHubSection />
  </main>
  <Footer />
</Base>
