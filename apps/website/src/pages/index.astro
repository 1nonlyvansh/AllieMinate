---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import CloudProviders from '../components/CloudProviders.astro';
import CrossDevice from '../components/CrossDevice.astro';
import FileTransfer from '../components/FileTransfer.astro';
import SyncSection from '../components/SyncSection.astro';
import Security from '../components/Security.astro';
import PlatformSection from '../components/PlatformSection.astro';
import DownloadSection from '../components/DownloadSection.astro';
import FeatureExplorer from '../components/FeatureExplorer.astro';
import GitHubSection from '../components/GitHubSection.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Intro />
    <CloudProviders />
    <CrossDevice />
    <FileTransfer />
    <SyncSection />
    <Security />
    <PlatformSection />
    <DownloadSection />
    <FeatureExplorer />
    <GitHubSection />
    <FinalCTA />
  </main>
  <Footer />
</Base>
