---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import Security from '../components/Security.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Security & Privacy — AllieMinate" description="What protects you in AllieMinate, and what doesn't — stated honestly, limitations included." path="/security">
  <Nav />
  <main id="main">
    <PageHeader eyebrow="Security & Privacy" title="Honest about what protects you — and what doesn't." intro="No AllieMinate-operated server, token-authenticated pairing, App Lock and destructive-action authentication. The real limitations are listed here too, not hidden." />
    <Security />
  </main>
  <Footer />
</Base>
