---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import PlatformSection from '../components/PlatformSection.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Platforms — AllieMinate" description="AllieMinate on macOS, Windows, and Android — what's supported on each, and how to install." path="/platforms">
  <Nav />
  <main id="main">
    <PageHeader eyebrow="Supported Platforms" title="macOS, Windows, and Android." intro="One app, three real installers. None are code-signed with a paid certificate yet — see the note on each platform for the one-time warning you'll see on first install." />
    <PlatformSection />
  </main>
  <Footer />
</Base>
