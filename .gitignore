# Dependencies & build output
node_modules/
dist/
*.tsbuildinfo

# --- Secrets — OAuth client IDs/secrets, API keys, refresh tokens for every connected cloud (Drive,
# OneDrive, B2, IDrive e2, MEGA, pCloud). Never commit these. ---
.env
.env.local
!.env.example

# --- Backend runtime state — written at runtime into apps/backend/ by default (ALLIMINATE_DATA_DIR
# overrides this), never source. Includes paired-device tokens, OAuth account records, and connection
# logs, all of which are per-install and sensitive. ---
apps/backend/device.json
apps/backend/devices.json
apps/backend/accounts.json
apps/backend/folders.json
apps/backend/trash.json
apps/backend/disabledProviders.json
apps/backend/masterDevice.json
apps/backend/nearbyShare.json
apps/backend/open-with.json
apps/backend/photos-accounts.json
apps/backend/photos-picked.json
apps/backend/receive-settings.json
apps/backend/remote-cache-index.json
apps/backend/transferHistory.json
apps/backend/trayFilter.json
apps/backend/username.json
apps/backend/cache-settings.json
apps/backend/cache/
apps/backend/Users/
apps/backend/sync/bandwidthLimit.json
apps/backend/syncIgnoreRules.json
apps/backend/syncPairs.json
apps/backend/syncTrash/
apps/backend/syncState/
apps/backend/local-folder-shortcuts.json

# local test fixtures created while developing the Sync Engine — not part of the app
.test-sync-folder/
.test-sync-folder-drive/
.test-sync-folder-mega/

# Desktop renderer bundles — esbuild output, regenerated by build/build-app.sh, not hand-edited
apps/desktop/src/renderer/bundle.js
apps/desktop/src/renderer/trayPanel-bundle.js

# Packaged app build output
apps/desktop/build/AllieMinate.app/
apps/desktop/build/AllieMinate.dmg
apps/desktop/build/ql-out/
apps/desktop/build/AllieMinate.iconset/

# --- Android / Gradle ---
apps/android/local.properties
apps/android/.gradle/
